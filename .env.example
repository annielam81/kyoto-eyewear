# KYOTO EYEWEAR environment template — copy to .env.local, never commit real values.
# development | staging | production select different values of the same keys.
VITE_API_BASE_URL=/api-mock
# Phase 4B+ (do NOT fill in Phase 4A):
# VITE_PAYMENT_PUBLIC_KEY=
# VITE_OAUTH_CLIENT_ID=

# ---- KYOTO 后台系统 · Supabase（admin-system 分支）----
# 复制为 .env 后填写真实值。含真实 key 的 .env 永远不许提交到 git。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# 仅服务端使用！拥有绕过 RLS 的全部权限，不许暴露给前端、不许提交
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Admin 后台（Vite + Vue3）----
# 浏览器里只能用 anon key，权限由 RLS 控制
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- AI 服务（用户以后提供，不许提交真实 key）----
# AI_* 全部注释掉。等用户提供 key 后，只填在本地 .env / 服务器环境变量里，
# 密钥永远只在服务端（Edge Function / 后端脚本）使用，前端代码不许引用。
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
